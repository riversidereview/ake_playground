# Backend API URL (for local dev: http://localhost:8000; for production: https://<your-api>.onrender.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional Asset CDN URL (leave blank for local /public/images; set to Vercel Blob store or CDN in production)
# Example: NEXT_PUBLIC_ASSET_CDN_URL=https://<store-id>.public.blob.vercel-storage.com
NEXT_PUBLIC_ASSET_CDN_URL=
